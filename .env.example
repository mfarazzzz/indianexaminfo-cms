# IndianExamInfo CMS — Environment Variables
# Copy this file to .env and fill in real values.

# Required: Supabase project URL (Supabase dashboard → Settings → API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Required: Supabase anon/public key (safe to expose in browser — RLS enforces access)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Frontend URL for preview links
VITE_FRONTEND_URL=https://indianexaminfo.com

# There is deliberately no VITE_REVALIDATE_TOKEN and no AI provider key here.
# Anything in a VITE_* variable is inlined into the built bundle, so it is public.
#   - cache revalidation goes through the `revalidate-frontend` Edge Function, which
#     reads `revalidate_token` from the settings table with the service role
#   - AI provider keys are Supabase secrets (AI_KEY_GROQ etc.) read only by `ai-fill`
# Set them with:  supabase secrets set AI_KEY_GROQ=...   (owner only)

# Optional: Enable raw HTML block in the Module Editor (restricted to admins)
# VITE_ENABLE_HTML_BLOCK=false
