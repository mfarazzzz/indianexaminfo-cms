# IndianExamInfo CMS — Environment Variables
# Copy this file to .env and fill in real values.

# Required: Supabase project URL (Supabase dashboard → Settings → API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Required: Supabase anon/public key (safe to expose in browser — RLS enforces access)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Frontend URL for preview links and cache revalidation
VITE_FRONTEND_URL=https://indianexaminfo.com

# Token to trigger frontend cache revalidation (must match REVALIDATE_TOKEN in frontend .env)
VITE_REVALIDATE_TOKEN=your-revalidate-secret-here

# Optional: Enable raw HTML block in the Module Editor (restricted to admins)
# VITE_ENABLE_HTML_BLOCK=false
