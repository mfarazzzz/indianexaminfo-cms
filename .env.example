# IndianExamInfo CMS — Environment Variables
# Copy this file to .env and fill in real values.
# All other configuration is done inside the CMS via Settings → Database.

# Required: Supabase project URL (found in Supabase dashboard → Settings → API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Required: Supabase anon/public key (safe to expose in browser — RLS enforces access)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Everything else (Gemini API key, revalidate token, etc.) is stored in the
# Supabase `settings` table and managed through Settings → AI / Frontend tabs.
