# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
dist-ssr/
build/

# Environment variables — NEVER commit real credentials
.env
.env.local
.env.production
.env.*.local

# Keep example file
!.env.example

# Editor
.vscode/settings.json
.vscode/launch.json
.idea/
*.swp
*.swo

# OS
.DS_Store
.DS_Store?
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
/var/log/

# TypeScript build info
*.tsbuildinfo

# Coverage
coverage/
.nyc_output/

# Playwright session state saved by `npm run cms:login` - never commit it
.auth/

# Scratch / build output files - never commit (repo hygiene rule)
tsc-*.txt
tc-done.txt
test-output.txt
git-check.txt
git-status.txt
qa/screenshots/

# Vite writes a transient ESM bundle of vite.config.ts ("vite.config.ts.timestamp-<epoch>-<hash>.mjs")
# into the repo root during build. It is a build byproduct, not source; ignore it so the
# build-stamp's `git status --porcelain` (vite.config.ts gitStamp) reports a clean tree as
# clean instead of always "built with uncommitted changes".
*.timestamp-*.mjs
